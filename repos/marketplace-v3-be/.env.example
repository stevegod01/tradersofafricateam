# Local development only. Production settings are configured in Azure App
# Service and production secrets are loaded directly from Azure Key Vault.

# App
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_NAME=Traders of Africa
APP_URL=http://127.0.0.1:3000/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=tofa_marketplace_dev
DB_SSL=false
# DB_SSL_CA_FILE=/absolute/path/to/ca.pem

# JWT (local development values only)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / Postmark
EMAIL_DELIVERY_ENABLED=false
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=Traders of Africa

# Swagger
SWAGGER_ENABLED=true
SWAGGER_REQUIRE_AUTH=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Google Auth
GOOGLE_CLIENT_ID=

# Uploads — DefaultAzureCredential is used locally; sign in with Azure CLI.
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=backend

# Logistics / Delivery Management
LOGISTICS_QUOTE_TTL_MINUTES=30
LOGISTICS_TRACKING_BASE_URL=http://127.0.0.1:3000/api/logistics/tracking
LOGISTICS_WEBHOOKS_ENABLED=false
LOGISTICS_WEBHOOK_SHARED_SECRET=

# Payment callbacks remain disabled until an authenticated provider integration
# is configured.
PAYMENT_WEBHOOKS_ENABLED=false
PAYMENT_WEBHOOK_SHARED_SECRET=

# Direct RFQ Management
DIRECT_RFQ_DEFAULT_EXPIRY_DAYS=14
DIRECT_RFQ_CHECKOUT_EXPIRY_HOURS=24

# Market RFQ Management
MARKET_RFQ_CHECKOUT_EXPIRY_HOURS=24
MARKET_RFQ_SELLER_NOTIFICATION_LIMIT=50

# Subscription Management
SUBSCRIPTION_DEFAULT_CURRENCY=NGN
SUBSCRIPTION_PAYMENT_EXPIRY_HOURS=24
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=7,1

# Analytics & Reporting
ANALYTICS_REPORTING_CURRENCY=USD
ANALYTICS_REPORT_RETENTION_DAYS=7

# Reviews, Ratings & Rewards Management
REVIEW_SUBMISSION_WINDOW_DAYS=60
REVIEW_REMINDER_DAYS=5
REVIEW_MAX_IMAGES=5
REVIEW_IMAGE_MAX_FILE_SIZE_MB=5
REVIEW_IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/webp
# Legacy defaults only; live base points use the REVIEW_SUBMITTED reward rule.
REWARD_PRODUCT_REVIEW_POINTS=10
REWARD_SELLER_REVIEW_POINTS=10
REWARD_REVIEW_WITH_IMAGE_BONUS=5
REWARD_MINIMUM_REVIEW_CHARACTERS=25
REWARD_MAX_REVIEW_REWARD_PER_ORDER=30

# Message Center Management
MESSAGE_MAX_CHARACTERS=5000
MESSAGE_MAX_ATTACHMENTS_PER_MESSAGE=5
MESSAGE_MAX_ATTACHMENT_SIZE_MB=20
MESSAGE_ALLOWED_ATTACHMENT_TYPES=jpg,jpeg,png,webp,pdf,doc,docx,xls,xlsx,csv,txt
MESSAGE_EDIT_WINDOW_MINUTES=15
MESSAGE_UNREAD_EMAIL_DELAY_MINUTES=30
MESSAGE_REPORTING_ENABLED=true

# Dispute Management
DISPUTE_WINDOW_DAYS=7
DISPUTE_BUYER_REASONS=Product not received,Wrong product received,Product significantly different from description,Damaged product,Incorrect quantity,Missing items,Delivery issue,Payment issue,Other
DISPUTE_SELLER_REASONS=Payment issue,Buyer failed to fulfil agreed obligation,Buyer-arranged logistics issue,Delivery acceptance issue,Other
DISPUTE_MAX_MESSAGE_CHARACTERS=5000
DISPUTE_MAX_MESSAGE_ATTACHMENTS=5
DISPUTE_MAX_EVIDENCE_FILES=10
DISPUTE_MAX_EVIDENCE_FILE_SIZE_MB=20
DISPUTE_EVIDENCE_UPLOAD_EXPIRY_HOURS=24
DISPUTE_ALLOWED_EVIDENCE_MIME_TYPES=image/jpeg,image/png,image/webp

# Notifications Management
NOTIFICATION_REALTIME_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_ANNOUNCEMENT_BATCH_SIZE=100
NOTIFICATION_DEFAULT_PAGE_LIMIT=20

# Internationalization & Localization Management
DEFAULT_LANGUAGE=en
FALLBACK_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,ar,sw,pt
TRANSLATION_PROVIDER=manual
TRANSLATION_AUTO_QUEUE_ENABLED=true
TRANSLATION_PROVIDER_ENDPOINT=

# Search, Discovery & Ranking Management
SEARCH_OUT_OF_STOCK_VISIBLE=true
SEARCH_HISTORY_LIMIT=30
SEARCH_POPULAR_WINDOW_DAYS=30
SEARCH_DEFAULT_FEATURE_DURATION_DAYS=7
SEARCH_FEATURED_BOOST_ENABLED=true
SEARCH_SUBSCRIPTION_PRIORITY_ENABLED=true
SEARCH_RATING_ENABLED=true
SEARCH_FRESHNESS_ENABLED=true
SEARCH_AVAILABILITY_ENABLED=true
SEARCH_FEATURED_BOOST=25
SEARCH_SUBSCRIPTION_PRIORITY_MAX_WEIGHT=50
SEARCH_RATING_WEIGHT=10
SEARCH_FRESHNESS_WEIGHT=8
SEARCH_AVAILABILITY_WEIGHT=10
SEARCH_OUT_OF_STOCK_PENALTY=20

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# One-time local admin seed. No defaults exist; production resolves these from
# Key Vault using the separate deployment identity.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

# Cancellation / Return / Refund Management (Module 20)
# Policy is database-backed: GET/PATCH /admin/returns/settings.
# Defaults: 7-day return window, changed-mind returns disabled,
# cancellation logistics refunds disabled, proportional fee reversal enabled.
# Return evidence reuses the Azure Blob configuration above (storage must be enabled).
# Notifications reuse NOTIFICATION_EMAIL_ENABLED and Postmark configuration.
# Enable automatic Paystack refunds only with the original payment integration key.
PAYSTACK_REFUNDS_ENABLED=false
PAYSTACK_SECRET_KEY=
# Other providers use manual reconciliation and refunds.confirm permission.
# Configure signed refund callbacks and read docs/after-sales.md before enabling.

# Central audit history: retained indefinitely by default; no automatic audit deletion.
# Nonzero periods define archive eligibility only; approve financial/security policy before archival.
AUDIT_LOG_RETENTION_DAYS=0
AUDIT_FINANCIAL_RETENTION_DAYS=0
AUDIT_SECURITY_RETENTION_DAYS=0
# Protected, owner-only CSV exports; maximum 100000 rows and 168 hours.
AUDIT_EXPORT_MAX_ROWS=10000
AUDIT_EXPORT_TTL_HOURS=24

# Module 22: operational settings are database-authoritative after migration.
# Manage return/dispute windows, OTP/lockout limits, upload policy, delivery availability,
# default language/currency/country, and new audit export expiry through /admin/settings.
# Review migration seed values against any customized legacy environment overrides.
# No new secrets are required. Provider/infrastructure secrets stay in secret management.
# Legacy AUDIT_EXPORT_TTL_HOURS is superseded by auditExportExpiryMinutes for new exports.

# Referral links use FRONTEND_URL above. Referral qualification, trade beneficiaries,
# and reward rules are managed via /admin/rewards/policy and /admin/reward-rules.
# Referral reward emails use NOTIFICATION_EMAIL_ENABLED and existing Postmark settings.

# Module 25: seller settlements and payouts
# AES-256-GCM keyring. Generate a key with: openssl rand -base64 32
# Store real keys in your secret manager; retain old key IDs for existing account snapshots.
PAYOUT_ENCRYPTION_KEYS={}
PAYOUT_ENCRYPTION_KEY_ID=
SETTLEMENT_WORKER_ENABLED=true
# Paystack is opt-in; manual payouts work without a gateway. NGN Nigerian bank accounts only.
PAYOUT_PAYSTACK_ENABLED=false
PAYOUT_PAYSTACK_SECRET_KEY=
# Also requires automaticSettlementEnabled=true, a currency ceiling, and prior admin approval.
PAYOUT_AUTOMATIC_PROCESSING_ENABLED=false
