{
  "name": "traders-of-africa-api",
  "version": "1.0.0",
  "description": "Traders of Africa Marketplace API",
  "main": "dist/main.js",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --watch --require ts-node/register/transpile-only src/main.ts",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "node dist/scripts/run-migrations.js",
    "migration:run:local": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:show:local": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "migration:revert:local": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:verify-compatibility": "node scripts/verify-migration-compatibility.js",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run build && node --test tests/api-routes.test.js tests/swagger-contracts.test.cjs",
    "test:after-sales": "npm run build && node --test tests/after-sales.test.cjs",
    "test:after-sales:mysql": "npm run build && node --test tests/after-sales.mysql.test.cjs",
    "test:audit-log": "npm run build && node --test tests/audit-log.test.cjs",
    "test:audit-log:mysql": "npm run build && node --test tests/audit-log.mysql.test.cjs",
    "audit:reconcile": "node dist/modules/audit-log/audit-log.maintenance.js",
    "audit:backfill": "node dist/modules/audit-log/audit-log.maintenance.js --backfill",
    "test:settings": "npm run build && node --test tests/system-settings.test.cjs",
    "test:settings:mysql": "npm run build && node --test tests/system-settings.mysql.test.cjs",
    "test:rewards": "npm run build && node --test tests/rewards.test.cjs",
    "test:rewards:mysql": "npm run build && node --test tests/rewards.mysql.test.cjs",
    "test:saved-products": "npm run build && node --test tests/saved-products.test.cjs",
    "test:saved-products:mysql": "npm run build && node --test tests/saved-products.mysql.test.cjs",
    "saved-products:cleanup": "node dist/modules/saved-product/saved-product.cleanup.js",
    "test:settlements": "npm run build && node --test tests/settlement.test.cjs",
    "test:settlements:mysql": "npm run build && node --test tests/settlement.mysql.test.cjs",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/keyvault-secrets": "4.10.0",
    "@azure/storage-blob": "12.32.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/proxy-addr": "^5.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "mysql2": "3.24.3",
    "postmark": "^4.0.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "@azure-rest/core-client": "2.7.0",
    "@azure/abort-controller": "2.1.2",
    "@azure/core-auth": "1.10.1",
    "@azure/core-client": "1.10.1",
    "@azure/core-http-compat": "2.4.0",
    "@azure/core-paging": "1.6.2",
    "@azure/core-rest-pipeline": "1.24.0",
    "@azure/core-tracing": "1.3.0",
    "@azure/core-util": "1.13.0",
    "@azure/core-xml": "1.5.0",
    "@azure/logger": "1.3.0",
    "@azure/storage-common": "12.4.0",
    "@typespec/ts-http-runtime": "0.3.6"
  }
}
